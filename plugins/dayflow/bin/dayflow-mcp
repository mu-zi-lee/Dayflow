#!/bin/sh
# Starts Dayflow's MCP server. The server ships inside Dayflow.app so it
# always matches the installed app's database, which is why this plugin
# carries a launcher rather than its own copy.
for cli in \
  "${DAYFLOW_CLI:-}" \
  "/Applications/Dayflow.app/Contents/Helpers/dayflow" \
  "$HOME/Applications/Dayflow.app/Contents/Helpers/dayflow" \
  "/usr/local/bin/dayflow"
do
  if [ -n "$cli" ] && [ -x "$cli" ]; then
    exec "$cli" mcp
  fi
done

echo "Dayflow is not installed. Get it at https://dayflow.so, then restart this plugin." >&2
exit 1
